<UserControl x:Class="DotSetupForge.UI.Views.FilesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="20,16,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- 左：文件树 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextDisabledBrush}">
                            <Run Text="包含 " /><Run Text="{Binding IncludedCount}" /><Run Text=" · 排除 " />
                            <Run Text="{Binding ExcludedCount}" /><Run Text=" · 总计 " />
                            <Run Text="{Binding TotalSizeText}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBool}}" />
                </Grid>

                <Grid>
                    <TreeView ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="OnSelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox IsChecked="{Binding CheckedState, Mode=TwoWay}"
                                              IsThreeState="{Binding IsDirectory}"
                                              Click="FileCheckBox_Click"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="7,0,0,0" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplaySize}" Margin="10,0,0,0" FontSize="11"
                                               Foreground="{StaticResource TextDisabledBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右：属性面板 -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="文件属性" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="选择左侧文件查看详细信息" FontSize="11.5"
                           Foreground="{StaticResource TextDisabledBrush}"
                           Visibility="{Binding HasSelection, Converter={StaticResource InvertedBoolToVisibility}}" />

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="名称" Style="{StaticResource FormLabelStyle}" Margin="0,4,0,2" />
                    <TextBlock Text="{Binding SelectedName}" Style="{StaticResource ValueTextStyle}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="相对路径" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding SelectedPath}" Style="{StaticResource ValueTextStyle}" FontSize="11.5"
                               TextWrapping="Wrap" />

                    <TextBlock Text="大小" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding SelectedSize}" Style="{StaticResource ValueTextStyle}" />

                    <TextBlock Text="类别" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding SelectedCategory}" Style="{StaticResource ValueTextStyle}" />

                    <Rectangle Style="{StaticResource DividerStyle}" />

                    <TextBlock Text="推荐配置" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                    <TextBlock Text="安装位置" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding SelectedLocation}" Style="{StaticResource ValueTextStyle}" FontSize="12" />

                    <TextBlock Text="升级策略" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding SelectedUpgrade}" Style="{StaticResource ValueTextStyle}" FontSize="12" />

                    <TextBlock Text="卸载策略" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding SelectedUninstall}" Style="{StaticResource ValueTextStyle}" FontSize="12" />

                    <TextBlock Text="提示：取消勾选的文件会加入排除规则，保存到 .pack.json。"
                               FontSize="11" Foreground="{StaticResource TextDisabledBrush}"
                               TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
