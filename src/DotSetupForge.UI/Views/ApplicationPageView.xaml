<UserControl x:Class="DotSetupForge.UI.Views.ApplicationPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Margin="28,20,28,36">

            <!-- 应用信息 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="应用程序" Style="{StaticResource SectionTitleStyle}" />

                    <!-- 源目录 -->
                    <TextBlock Text="源目录" Style="{StaticResource FormLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Project.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" ToolTip="{Binding Project.SourcePath}" />
                        <Button Grid.Column="1" Content="重新选择" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding ChangeSourceDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="推荐使用 publish 输出目录（bin\Release\net10.0-windows\publish）"
                               FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Margin="0,4,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="主程序" Style="{StaticResource FormLabelStyle}" />
                            <TextBox Text="{Binding Project.MainExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="产品名称" Style="{StaticResource FormLabelStyle}" />
                            <TextBox Text="{Binding Project.ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,12,0">
                            <TextBlock Text="版本（SemVer）" Style="{StaticResource FormLabelStyle}" />
                            <TextBox Text="{Binding Project.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,0">
                            <TextBlock Text="发布者" Style="{StaticResource FormLabelStyle}" />
                            <TextBox Text="{Binding Project.Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="用于安装目录与卸载信息，例如 XXX科技有限公司" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <TextBlock Text="安装程序与快捷方式 ICO 图标（可选）" Style="{StaticResource FormLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Project.SetupIconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True" ToolTip="为空时使用默认图标；已选 ICO 同时用于桌面和开始菜单快捷方式" />
                                <Button Grid.Column="1" Content="选择 ICO" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Command="{Binding SelectSetupIconCommand}" />
                                <Button Grid.Column="2" Content="清除" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Command="{Binding ClearSetupIconCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding SetupIconStatus}" FontSize="11"
                                       Foreground="{StaticResource TextDisabledBrush}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 自动分析结果 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自动分析结果" Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1" Content="重新分析" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ReanalyzeCommand}" />
                    </Grid>

                    <!-- 状态徽章 -->
                    <Border Style="{StaticResource BadgeSuccessStyle}"
                            Visibility="{Binding AnalysisSucceeded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✓ 分析正常" Foreground="{StaticResource SuccessBrush}" FontSize="12" />
                    </Border>
                    <Border Style="{StaticResource BadgeErrorStyle}" Margin="0,8,0,0"
                            Visibility="{Binding AnalysisSucceeded, Converter={StaticResource InvertedBoolToVisibility}}">
                        <TextBlock Text="{Binding AnalysisStatus}" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Rectangle Style="{StaticResource DividerStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,24,10">
                            <TextBlock Text="程序类型" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding ApplicationType}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="24,0,0,10">
                            <TextBlock Text=".NET TFM" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding TargetFramework}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,24,10">
                            <TextBlock Text="Framework" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding FrameworkName}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="24,0,0,10">
                            <TextBlock Text="Framework 版本" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding FrameworkVersion}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,24,10">
                            <TextBlock Text="所需 Runtime" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding RuntimeName}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="24,0,0,10">
                            <TextBlock Text="架构" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding Architecture}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="部署模式" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding DeploymentMode}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Text="文件数量" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Text="{Binding FileCount}" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
