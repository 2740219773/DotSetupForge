<UserControl x:Class="DotSetupForge.UI.Views.InstallerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:DotSetupForge.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <conv:StringEqualsConverter x:Key="StringEquals" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Margin="28,20,28,36">

            <!-- 安装范围 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="安装范围" Style="{StaticResource SectionTitleStyle}" />

                    <RadioButton IsChecked="{Binding Project.InstallScope, Converter={StaticResource StringEquals}, ConverterParameter=Machine}"
                                 Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="所有用户（需要管理员权限）" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Program Files" FontSize="11"
                                       Foreground="{StaticResource TextDisabledBrush}" Margin="10,2,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsChecked="{Binding Project.InstallScope, Converter={StaticResource StringEquals}, ConverterParameter=User}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前用户（无需管理员权限）" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="LocalAppData\Programs" FontSize="11"
                                       Foreground="{StaticResource TextDisabledBrush}" Margin="10,2,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="{Binding ScopeHint}" FontSize="11.5"
                               Foreground="{StaticResource WarningBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- 安装目录 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="安装目录" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="使用 Inno Setup 常量模板，留空时自动生成（{autopf}\{Publisher}\{Name}）。"
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding Project.InstallDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如 {autopf}\{Publisher}\{ProductName}" />
                </StackPanel>
            </Border>

            <!-- 快捷方式与行为 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="快捷方式与安装行为" Style="{StaticResource SectionTitleStyle}" />

                    <CheckBox IsChecked="{Binding Project.CreateDesktopShortcut, Mode=TwoWay}"
                              Content="创建桌面快捷方式" Margin="0,4,0,10" />
                    <CheckBox IsChecked="{Binding Project.CreateStartMenuShortcut, Mode=TwoWay}"
                              Content="创建开始菜单快捷方式" Margin="0,0,0,10" />
                    <CheckBox IsChecked="{Binding Project.LaunchAfterInstall, Mode=TwoWay}"
                              Content="安装完成后运行程序" Margin="0,0,0,10" />
                    <CheckBox IsChecked="{Binding Project.AllowUpgrade, Mode=TwoWay}"
                              Content="支持覆盖升级（保持 AppId 不变，升级时保留用户配置）"
                              Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- 卸载行为说明 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="卸载行为" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="默认：卸载时删除程序文件与快捷方式，保留用户配置与数据（工业软件推荐）。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
