<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 色板：暗色专业工具风 ===== -->

    <!-- 背景层级 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1D21" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#22242A" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2D34" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#32363E" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#3A3F49" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#383C45" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#464B56" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA0A8" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C6169" />

    <!-- 主色（accent） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA0FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B76E0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2E4A" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#14321C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3A1516" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#332A12" />
    <SolidColorBrush x:Key="InfoBrush" Color="#58A6FF" />

    <!-- 输入控件底色 -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1F2126" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#262930" />

</ResourceDictionary>
