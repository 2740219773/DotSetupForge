<Application x:Class="DotSetupForge.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DotSetupForge.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
            <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyToVisibility" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:BoolToOpacityConverter x:Key="BoolOpacity" />
            <conv:EmptyTextToVisibilityConverter x:Key="EmptyTextToVisibility" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
